# Django настройки

# КРИТИЧЕСКИ ВАЖНО: Сгенерируйте новый секретный ключ для продакшена!
# Можно использовать: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Режим отладки (True для разработки, False для продакшена)
DJANGO_DEBUG=True

# Разрешенные хосты (разделенные запятыми, без пробелов)
# Для разработки: localhost,127.0.0.1
# Для продакшена: example.com,www.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# База данных (опционально, по умолчанию SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
